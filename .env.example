# ==========================================
# Kasa ve Defter-i Kebir Platformu - Global ENV Template
# ==========================================

# ------------------------------------------
# Backend Config (Go Fiber)
# ------------------------------------------
PORT=8080
ENVIRONMENT=development
# Supabase DB Connection String (Transaction Pooler or Direct Connection)
DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Supabase JWT Secret (Project Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ------------------------------------------
# Frontend Config (Next.js 15)
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ==============================================================================
# DEFSYSTEM - CANLI (PRODUCTION) ORTAM DEĞİŞKENLERİ ŞABLONU (.env.production.example)
# ==============================================================================
# Bu dosya canlı dağıtım (Render, Vercel, Supabase vb.) ortamında tanımlanması
# gereken tüm zorunlu değişkenleri ve açıklamalarını içerir.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND (Go API - Render / Docker / VM)
# ------------------------------------------------------------------------------
# Dinlenecek port (Render/Cloud platformları $PORT'u otomatik sağlar)
PORT=8080

# Ortam tipi (Zorunlu: Fail-secure için "production" olmalıdır)
ENVIRONMENT=production

# Supabase Canlı PostgreSQL Bağlantı URL'si (PgBouncer Pooler port 6543 veya Direct 5432)
# Örnek: postgres://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Supabase JWT Secret (Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret)
# Token imzalarını doğrulamak için zorunludur.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Supabase Auth Issuer URL (Token sahteciliğini önlemek için zorunlu doğrulama)
SUPABASE_ISSUER=https://[YOUR-PROJECT-REF].supabase.co/auth/v1

# İzin verilen CORS Domainleri (Virgülle ayrılmış, canlı domainler)
ALLOWED_ORIGINS=https://www.oncuotogazmuhasebe.com.tr,https://oncuotogazmuhasebe.com.tr,https://muhasebe-ve-finans-otomasyonu-2.onrender.com

# ------------------------------------------------------------------------------
# 2. FRONTEND (Next.js - Vercel / Cloudflare Pages / Node.js)
# ------------------------------------------------------------------------------
# Canlı Go Backend API URL'si (/api/v1 dahil edilmelidir)
NEXT_PUBLIC_API_URL=https://muhasebe-ve-finans-otomasyonu-2.onrender.com/api/v1

# Supabase Proje URL'si (Dashboard -> Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co

# Supabase Anon/Public API Key (Dashboard -> Project Settings -> API -> Project API Keys -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. İSTEĞE BAĞLI / TEST ORTAMI DEĞİŞKENLERİ
# ------------------------------------------------------------------------------
# Test araçlarında canlı API'yi hedeflemek için:
# LIVE_API_URL=https://muhasebe-ve-finans-otomasyonu-2.onrender.com/api/v1

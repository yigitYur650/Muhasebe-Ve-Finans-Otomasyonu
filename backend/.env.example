# Go Fiber API Server Port
PORT=8080

# Environment Mode (development / production)
ENVIRONMENT=production

# Supabase PostgreSQL Connection String
# Get from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Supabase JWT Secret (for verifying access tokens)
# Get from Supabase Dashboard -> Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

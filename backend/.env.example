# Go Fiber API Server Port
PORT=8080

# Environment Mode (development / production)
ENVIRONMENT=production

# Supabase PostgreSQL Connection String
# Get from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Supabase JWT Secret (for verifying access tokens)
# Get from Supabase Dashboard -> Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Telegram Critical Error & Backup Notification Bot
# Create via @BotFather and get chat ID via @userinfobot
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Google Drive Automated Daily Backup
GDRIVE_BACKUP_ENABLED=false
GDRIVE_CREDENTIALS_FILE=credentials.json
GDRIVE_BACKUP_FOLDER_ID=your_gdrive_backup_folder_id_here
GDRIVE_BACKUP_CRON="0 3 * * *"
GDRIVE_RETENTION_DAYS=30

